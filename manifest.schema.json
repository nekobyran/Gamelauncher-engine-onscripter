{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamelauncher.invalid/schemas/distribution-manifest-v2.json",
  "title": "GameLauncher downloadable component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "version",
    "payloadClass",
    "requires",
    "runnerApi",
    "testedTargets",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "engine",
        "model",
        "shell"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "payloadClass": {
      "enum": [
        "weights",
        "shader-pack",
        "kernel-sdk",
        "source",
        "runner"
      ]
    },
    "requires": {
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": "array"
    },
    "runnerApi": {
      "type": [
        "string",
        "null"
      ]
    },
    "testedTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "abi"
        ],
        "properties": {
          "platform": {
            "enum": [
              "android",
              "windows",
              "linux",
              "macos"
            ]
          },
          "abi": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "abi",
          "format",
          "url",
          "sha256",
          "sizeBytes",
          "maxInstalledBytes",
          "fileName"
        ],
        "properties": {
          "platform": {
            "enum": [
              "android",
              "windows",
              "linux",
              "macos"
            ]
          },
          "abi": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "zip",
              "apk",
              "raw"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "maxInstalledBytes": {
            "type": "integer",
            "minimum": 1
          },
          "fileName": {
            "type": "string",
            "pattern": "^[^/\\\\]+$"
          }
        }
      }
    }
  }
}
